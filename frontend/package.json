{
  "name": "guitar-mentor-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/metronome.test.mjs tests/metronome-ui.test.mjs tests/metronome-dialog.component.test.mjs tests/metronome-recording.component.test.mjs tests/metronome-shell.component.test.mjs tests/metronome-entry-flow.test.mjs tests/locale-persistence.test.mjs",
    "test:intake": "node --experimental-strip-types --test tests/intake-navigation.test.mjs tests/diagnostic-component.test.mjs tests/evidence-panel.component.test.mjs",
    "test:tuner": "node --experimental-strip-types --test src/shared/tuner/pitch.test.mjs"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-i18n": "^11.1.9",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vue-tsc": "^3.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
