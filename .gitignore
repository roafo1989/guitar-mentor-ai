# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.iml
.classpath
.project
.settings/

# Java and Maven
**/target/
.mvn/wrapper/maven-wrapper.jar
*.log

# Vue/Node (future frontend)
**/node_modules/
**/dist/
**/.vite/

# Local config, secrets and PostgreSQL dumps
.env
.env.*
!.env.example
*.local
*.sql.gz
*.dump
*.backup

# Python prototype leftovers, not part of Java backend
.venv/
venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]
*.egg-info/

# User data and media
data/
media/
uploads/
*.db
*.sqlite
*.sqlite3

# Preview media remain ignored except verified project-owned distribution assets
/backend/src/main/resources/exercises/**/*.pdf
/backend/src/main/resources/exercises/**/*.mp3

# Private uploaded test recordings (never commit)
/backend/.local-media/
/.local-media/

# Local #216 acceptance reports (may contain project or test data)
.qa-local/

# Original generated GM-EB01 0.8B package, restored for reproducible installs (#237).
!/backend/src/main/resources/exercises/GM-EB01/score_v08B.pdf
!/backend/src/main/resources/exercises/GM-EB01/preview_v08B.mp3

# Disaster recovery: local configuration/reports and cloud credentials never enter Git
.recovery-local/
recovery.local.json
recovery-status.local.json
acceptance-progress.local.json
recovery-acceptance-report.json
rclone.conf
*.bundle
